{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "palette": {
    "black": "0",
    "blue": "4",
    "frame": "244",
    "green": "2",
    "grey": "8",
    "red": "1",
    "white": "7",
    "yellow": "3",
    "xterm232": "232",
    "xterm254": "254"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame",
          "template": "╭─"
        },
        {
          "type": "os",
          "style": "diamond",
          "foreground": "p:xterm232",
          "background": "p:white",
          "leading_diamond": "",
          "template": " {{ .Icon }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:xterm254",
          "background": "p:blue",
          "properties": {
            "style": "agnoster_short"
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:black",
          "background": "p:green",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Behind 0 }}p:red{{ end }}"
          ],
          "properties": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }}{{ if eq .Behind 0 }} {{ end }}⇡{{ .Ahead }}{{ end }}{{ if gt .StashCount 0 }} *{{ .StashCount }}{{ end }}{{ if gt .Staging.Added 0 }} +{{ .Staging.Added }}{{ end }}{{ if gt .Staging.Modified 0 }} +{{ .Staging.Modified }}{{ end }}{{ if gt .Staging.Deleted 0 }} +{{ .Staging.Deleted }}{{ end }}{{ if gt .Staging.Unmerged 0 }} ~{{ .Staging.Unmerged }}{{ end }}{{ if gt .Working.Unmerged 0 }} ~{{ .Working.Unmerged }}{{ end }}{{ if gt .Working.Modified 0 }} !{{ .Working.Modified }}{{ end }}{{ if gt .Working.Deleted 0 }} !{{ .Working.Deleted }}{{ end }}{{ if gt .Working.Added 0 }} !{{ .Working.Added }}{{ end }}{{ if gt .Working.Untracked 0 }} ?{{ .Working.Untracked }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:green",
          "background": "p:black",
          "properties": {
            "always_enabled": true
          },
          "template": " {{ if eq .Code 0 }}✔{{ else }}✘ {{ .Code }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:black",
          "background": "p:yellow",
          "properties": {
            "threshold": 3000
          },
          "template": " took {{ .FormattedMs }} "
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:black",
          "background": "p:blue",
          "properties": {
            "display_mode": "environment",
            "fetch_version": false
          },
          "template": "{{ if .Venv }} {{ .Venv }} {{ end }}"
        },
        {
          "type": "time",
          "style": "diamond",
          "foreground": "p:black",
          "background": "p:white",
          "leading_diamond": "",
          "trailing_diamond": "",
          "properties": {
            "time_format": "03:04:05 PM"
          },
          "template": " at {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame",
          "template": "─╮"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame",
          "template": "╰─"
        }
      ]
    }
  ],
  "secondary_prompt": {
    "foreground": "p:frame",
    "background": "transparent",
    "template": "├─> "
  }
}
