{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "palette": {
    "black": "#1f2430",
    "blue": "#4b95e9",
    "cyan": "#56b6c2",
    "green": "#59c9a5",
    "grey": "#6c7086",
    "orange": "#f07623",
    "red": "#d81e5b",
    "white": "#e0def4",
    "yellow": "#f3ae35"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "foreground": "p:black",
          "background": "p:white",
          "leading_diamond": "╭─",
          "template": " {{ .Icon }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:black",
          "background": "p:green",
          "properties": {
            "style": "agnoster_short"
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:white",
          "background": "p:orange",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:cyan{{ end }}",
            "{{ if gt .Behind 0 }}p:red{{ end }}"
          ],
          "properties": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }}{{ if .Working.Changed }} ±{{ .Working.String }}{{ end }}{{ if .Staging.Changed }} +{{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} ≡{{ .StashCount }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:green",
          "background": "p:black",
          "properties": {
            "always_enabled": true
          },
          "template": " {{ if eq .Code 0 }}✔{{ else }}✘ {{ .Code }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:black",
          "background": "p:yellow",
          "properties": {
            "threshold": 3000
          },
          "template": " took {{ .FormattedMs }} "
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:black",
          "background": "p:blue",
          "properties": {
            "display_mode": "environment",
            "fetch_version": false
          },
          "template": "{{ if .Venv }} {{ .Venv }} {{ end }}"
        },
        {
          "type": "time",
          "style": "diamond",
          "foreground": "p:black",
          "background": "p:white",
          "leading_diamond": "",
          "trailing_diamond": "",
          "properties": {
            "time_format": "03:04:05 PM"
          },
          "template": " at {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:blue",
          "template": "╰─"
        }
      ]
    }
  ],
  "secondary_prompt": {
    "foreground": "p:yellow",
    "background": "transparent",
    "template": "├─> "
  }
}
