{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "palette": {
    "black": "16",
    "blue": "68",
    "frame": "#4C566A",
    "green": "108",
    "grey": "#434C5E",
    "panel": "#3B4252",
    "red": "131",
    "white": "#ECEFF4",
    "yellow": "220",
    "xterm232": "16",
    "xterm254": "#ECEFF4"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame",
          "template": "╭─"
        },
        {
          "type": "os",
          "style": "diamond",
          "foreground": "p:xterm232",
          "background": "p:white",
          "leading_diamond": "",
          "template": " {{ .Icon }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:xterm254",
          "background": "p:blue",
          "properties": {
            "style": "agnoster_short"
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:black",
          "background": "p:green",
          "cache": {
            "duration": "2s",
            "strategy": "folder"
          },
          "timeout": 750,
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Behind 0 }}p:red{{ end }}"
          ],
          "properties": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }}{{ if eq .Behind 0 }} {{ end }}⇡{{ .Ahead }}{{ end }}{{ if gt .StashCount 0 }} *{{ .StashCount }}{{ end }}{{ if gt .Staging.Added 0 }} +{{ .Staging.Added }}{{ end }}{{ if gt .Staging.Modified 0 }} +{{ .Staging.Modified }}{{ end }}{{ if gt .Staging.Deleted 0 }} +{{ .Staging.Deleted }}{{ end }}{{ if gt .Staging.Unmerged 0 }} ~{{ .Staging.Unmerged }}{{ end }}{{ if gt .Working.Unmerged 0 }} ~{{ .Working.Unmerged }}{{ end }}{{ if gt .Working.Modified 0 }} !{{ .Working.Modified }}{{ end }}{{ if gt .Working.Deleted 0 }} !{{ .Working.Deleted }}{{ end }}{{ if gt .Working.Added 0 }} !{{ .Working.Added }}{{ end }}{{ if gt .Working.Untracked 0 }} ?{{ .Working.Untracked }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:green",
          "background": "p:panel",
          "properties": {
            "always_enabled": true
          },
          "template": " {{ if eq .Code 0 }}✔{{ else }}✘ {{ .Code }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:black",
          "background": "p:yellow",
          "properties": {
            "threshold": 3000
          },
          "template": " took {{ .FormattedMs }} "
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:black",
          "background": "p:blue",
          "template": "{{ if .Env.VIRTUAL_ENV }} {{ osBase .Env.VIRTUAL_ENV }} {{ else if .Env.CONDA_DEFAULT_ENV }} {{ .Env.CONDA_DEFAULT_ENV }} {{ end }}"
        },
        {
          "type": "time",
          "style": "diamond",
          "foreground": "p:black",
          "background": "p:white",
          "leading_diamond": "",
          "trailing_diamond": "",
          "properties": {
            "time_format": "03:04:05 PM"
          },
          "template": " at {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame",
          "template": "─╮"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame",
          "template": "╰─"
        }
      ]
    }
  ],
  "secondary_prompt": {
    "foreground": "p:frame",
    "background": "transparent",
    "template": "├─> "
  }
}
